# Copy to backend/.env and fill in. Never commit the real file.
ENV=development
DEBUG=False

# Internal PostgreSQL (organizations, users, ownership, sync logs)
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
DB_NAME=lia_db

# REQUIRED. Generate with: openssl rand -hex 32   (>= 32 chars in production)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# Encrypts tenant connector credentials at rest (REQUIRED in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate several keys to rotate (first encrypts, all decrypt).
CONNECTOR_ENCRYPTION_KEY=

# Comma-separated browser origins allowed to call the API (no "*" in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Behind a reverse proxy set to the number of proxies (1 for the bundled nginx)
TRUSTED_PROXY_COUNT=0
# Rate limit storage; use redis://host:6379 when running several gunicorn workers/replicas
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=5 per minute;30 per hour
# Reject connector DB hosts that resolve to private/loopback addresses (SSRF hardening)
BLOCK_PRIVATE_CONNECTOR_HOSTS=False
# Extra allowed Salesforce hostname suffixes (comma separated), e.g. for private domains
SALESFORCE_EXTRA_HOST_SUFFIXES=

OPENAI_API_KEY=
LLM_MODEL_NAME=gpt-3.5-turbo
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
